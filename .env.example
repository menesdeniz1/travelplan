# TravelPlan ortam ayarları örneği.
#
# Kullanım:
#   1. Bu dosyayı .env adıyla kopyalayın:  copy .env.example .env   (macOS/Linux: cp .env.example .env)
#   2. .env içinde gerekli satırları doldurun. Boş bırakılan satırlar yok sayılır.
#   3. Sunucuyu yeniden başlatın. Sunucu repo kökündeki .env dosyasını kendisi okur.
#
# Öncelik: gerçek ortam değişkeni (kabuk, launchd, Görev Zamanlayıcı) .env'den önce gelir.
# .env gerçek sırlar içerir: git'e eklemeyin (.gitignore bunu zaten engeller).
# Bu dosyanın kendisine yalnızca güvenli varsayılanlar ve boş değerler yazılmıştır.

# --- Telegram bildirimleri (fiyat düşüşü uyarıları) ---
# BotFather'dan alınan bot token'ı. Boş ise Telegram bildirimi kapalıdır.
TELEGRAM_BOT_TOKEN=
# Bildirimin gideceği sohbet ID'si (kişisel sohbet veya grup).
TELEGRAM_CHAT_ID=

# --- Sunucu ---
# Dinlenecek adres. 127.0.0.1: yalnızca bu bilgisayar. Mac'in LAN IP'si: ağdaki diğer cihazlar.
TRAVELPLAN_HOST=127.0.0.1
# Dinlenecek port.
TRAVELPLAN_PORT=8085
# Ağdan erişimde Host/Origin başlığında kabul edilecek ek ad listesi (virgülle ayrılmış).
# Örnek: mac.local,192.168.1.20   Boş: yalnızca varsayılan adlar.
TRAVELPLAN_ALLOWED_HOSTS=
# Günlüğü konsola da yaz (1: evet). Varsayılan: terminaldeyse konsola, değilse yalnızca logs/server.log.
TRAVELPLAN_LOG_CONSOLE=0

# --- Veri dosyaları ---
# Ana SQLite veritabanı yolu. Boş: repo kökündeki travelplan.db.
TRAVELPLAN_DB=
# Arama günlüğü (SQLite) yolu. Boş: repo kökündeki search_log.db.
TRAVELPLAN_SEARCH_LOG=
# Eski JSON dosyalarından otomatik göçü kapatır (1: kapalı). Normalde 0 bırakın.
TRAVELPLAN_NO_MIGRATE=0

# --- Google Flights tarayıcı (Playwright) ---
# Aynı anda açık tarayıcı sayfası sınırı (en az 1). Varsayılan 1 (düşük RAM). 2 yaparsanız paralel arama
# açılır; her tarayıcı yaklaşık 400 MB RAM kullanır.
TRAVELPLAN_MAX_BROWSERS=1
# Arama yapılmadan kaç saniye sonra paylaşılan tarayıcı kapansın.
TRAVELPLAN_BROWSER_IDLE_SECS=300
# Paylaşılan tarayıcı kullanımı (1: açık, 0: her aramada yeni tarayıcı).
TRAVELPLAN_BROWSER_REUSE=1

# --- Kur ---
# EUR -> TRY kurunu elle sabitler (örnek: 55.5). Boş: canlı kur kaynakları kullanılır.
TRAVELPLAN_EUR_TRY=

# --- Google Haritalar (tren/otobüs saatleri, yedek kaynak) ---
# Bir aramada en fazla kaç Google Haritalar sayfa yüklemesi yapılsın. Varsayılan 4. 0: Maps kapalı.
# Fiyatlı kaynaklar (RegioJet, FlixBus, Trenitalia) sonuç vermediğinde kullanılır.
TRAVELPLAN_MAPS_BUDGET=4

# --- Kara yolu önbelleği (tren ve otobüs, gün bazlı, kalıcı) ---
# Veritabanı yolu. Boş: repo kökündeki ground_cache.db. "off": önbellek kapalı.
TRAVELPLAN_GROUND_CACHE=
# Dolu bir kara yolu yanıtının geçerlilik süresi (saniye). Varsayılan 21600 (6 saat). Boş yanıtlar 1 saat.
TRAVELPLAN_GROUND_CACHE_TTL_SECS=21600
# En fazla satır sayısı; fazlası en eskiden silinir. Varsayılan 5000.
TRAVELPLAN_GROUND_CACHE_MAX_ROWS=5000

# --- Transitous (toplu taşıma verisi, isteğe bağlı) ---
# Yalnızca tam olarak 1 ise açılır. Varsayılan kapalı (ağ çağrısı yapılmaz).
TRAVELPLAN_TRANSITOUS=0

# --- Google Hotels (gece beklemesinde gerçek otel fiyatı, isteğe bağlı / opt-in) ---
# Yalnızca 1 ise açılır. Varsayılan 0 (kapalı).
TRAVELPLAN_HOTELS=0
# Arama başına en fazla sayfa yükleme sayısı. Varsayılan 2.
TRAVELPLAN_HOTELS_BUDGET=2
# Otel fiyat önbelleği veritabanı yolu. Boş: repo kökündeki hotel_cache.db. "off": önbellek kapalı.
TRAVELPLAN_HOTELS_CACHE=

# --- Gece önbellek ısıtma (takipli trip rotaları, prefetch) ---
# Takipli rotaları gece önceden tarar (1: açık [varsayılan], 0: kapalı).
TRAVELPLAN_PREFETCH=1
# Prefetch'in çalışacağı yerel saat aralığı (varsayılan 03:00-05:00).
TRAVELPLAN_PREFETCH_WINDOW=03:00-05:00

# Not: TRAVELPLAN_ENV_FILE (alternatif .env yolu) bu dosyanın içine yazılmaz; kabukta veya
# servis tanımında ayarlanır. Belirtilmezse repo kökündeki .env okunur.
